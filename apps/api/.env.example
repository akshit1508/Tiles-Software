# Node Environment
NODE_ENV=production
PORT=3001

# MongoDB Connection String (MongoDB Atlas Free M0 Sandbox)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/goverdhan-traders?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/goverdhan-traders?retryWrites=true&w=majority

# JWT Authentication Secret (Generate a strong random 32+ character string)
AUTH_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Frontend URL (For CORS and cross-site cookies)
# Set this to your deployed Vercel domain (e.g., https://goverdhan-traders.vercel.app)
FRONTEND_URL=https://your-frontend-app.vercel.app

# Initial Owner Admin Seed Credentials (Optional: used when running npm run seed:admin)
ADMIN_EMAIL=owner@goverdhan.com
ADMIN_PASSWORD=YourSecureOwnerPassword123!
ADMIN_NAME=Goverdhan Owner
