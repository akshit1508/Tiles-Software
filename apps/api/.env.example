# Server
PORT=3001
NODE_ENV=development

# MongoDB
DATABASE_URL=mongodb://localhost:27017/goverdhan-traders

# Authentication
AUTH_SECRET=development-secret-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Initial Owner Seed Credentials (npm run seed:admin)
ADMIN_EMAIL=owner@goverdhan.com
ADMIN_PASSWORD=change_this_secure_password_123

# Frontend
FRONTEND_URL=http://localhost:3000
